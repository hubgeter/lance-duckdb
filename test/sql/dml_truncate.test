# name: test/sql/dml_truncate.test
# description: Truncate for Lance namespace tables
# group: [sql]

require lance

statement ok
ATTACH 'test/.tmp' AS ns (TYPE LANCE);

statement ok
CREATE OR REPLACE TABLE ns.main.truncate_table_test AS
  SELECT 1::BIGINT AS id, 'a'::VARCHAR AS s
  UNION ALL
  SELECT 2::BIGINT AS id, 'b'::VARCHAR AS s;

query I
SELECT count(*) FROM ns.main.truncate_table_test
----
2

# TRUNCATE is represented as a pending Lance delete transaction.  Rolling the
# DuckDB transaction back must leave the dataset unchanged.
statement ok
BEGIN;

query I
TRUNCATE TABLE ns.main.truncate_table_test;
----
2

statement ok
ROLLBACK;

query I
SELECT count(*) FROM ns.main.truncate_table_test
----
2

statement ok
TRUNCATE TABLE ns.main.truncate_table_test;

query I
SELECT count(*) FROM ns.main.truncate_table_test
----
0

statement ok
INSERT INTO ns.main.truncate_table_test VALUES (3::BIGINT, 'c'::VARCHAR);

query I
SELECT sum(id) FROM ns.main.truncate_table_test
----
3

statement ok
DETACH ns;

statement ok
ATTACH 'test/.tmp' AS readonly_ns (TYPE LANCE, READ_ONLY true);

# The internal table function is reachable from SQL and must enforce the same
# catalog mutability contract as the TRUNCATE parser extension.
statement error
SELECT * FROM __lance_truncate_table('readonly_ns', 'main', 'truncate_table_test');
----
Invalid Input Error: TRUNCATE TABLE cannot modify a Lance table through an attachment in read-only mode

query I
SELECT count(*) FROM readonly_ns.main.truncate_table_test
----
1

statement ok
DETACH readonly_ns;
