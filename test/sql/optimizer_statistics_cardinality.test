# name: test/sql/optimizer_statistics_cardinality.test
# description: Optimizer statistics hooks (cardinality/partition stats)
# group: [sql]

require lance

# Bind-time optimization must not issue potentially blocking remote row-count
# IO. DuckDB therefore keeps its conservative fallback estimate here.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM 'test/data/test_data.lance';
----
physical_plan	<REGEX>:[\s\S]*"Estimated Cardinality": "1"[\s\S]*

# COUNT(*) is executed by Lance's aggregate pushdown instead of scanning rows
# through DuckDB.
query II
EXPLAIN (FORMAT JSON) SELECT count(*) FROM 'test/data/test_data.lance';
----
physical_plan	<REGEX>:[\s\S]*"name": "__LANCE_EXEC"[\s\S]*
