# name: test/sql/scan_smoke.test
# description: Smoke tests for scan and replacement scan
# group: [sql]

require lance

# Extension loads
query I
SELECT 1;
----
1

# Replacement scan for SELECT * FROM '.../dataset.lance'
statement ok
SELECT * FROM 'test/data/test_data.lance' LIMIT 1;

# Error handling: invalid dataset root
statement error
SELECT * FROM 'dummy_path.lance';
----
IO Error: Failed to open Lance dataset: dummy_path.lance (Lance error: dataset open 'dummy_path.lance':

# A path-like replacement scan is one Lance dataset, never a file glob.
statement error
SELECT * FROM 'test/data/*.lance';
----
Invalid Input Error: Lance replacement scans do not support glob patterns: test/data/*.lance. Open one dataset path at a time.

# Top-level column names containing dots are quoted as one Lance field path.
statement ok
COPY (SELECT 1 AS "literal.dot", 2 AS plain)
TO 'test/.tmp/scan_dotted_column.lance' (FORMAT lance, mode 'overwrite');

query II
SELECT "literal.dot", plain FROM 'test/.tmp/scan_dotted_column.lance';
----
1	2
